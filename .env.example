# .env.example
# Kopiere diese Datei zu .env und passe die Werte an

# ============================================================================
# UART-Konfiguration
# ============================================================================

# Aktiviere UART als Datenquelle (true/false)
UART_ENABLED=false

# Serieller Port (Raspberry Pi)
# Häufige Werte:
#   /dev/ttyAMA0  - Hardware UART (UART0 auf GPIO14/15)
#   /dev/ttyS0    - Softare UART (auf manchen RPi)
#   /dev/ttyUSB0  - USB-Serial Adapter
UART_PORT=/dev/ttyAMA0

# Baudrate (muss mit ESP32 übereinstimmen)
UART_BAUD=115200

# ============================================================================
# Web-Server
# ============================================================================

# Port für Express/Socket.IO Server
PORT=3000

# ============================================================================
# Datenbank (aus bestehender Konfiguration)
# ============================================================================

DB_HOST=127.0.0.1
DB_USER=da_app
DB_PASSWORD=DiplomArbeit2025
DB_NAME=da_webapp
DB_PORT=3306

# ============================================================================
# NODE Umgebung (Development/Production)
# ============================================================================

NODE_ENV=development
# NODE_ENV=production

# ============================================================================
# Logging
# ============================================================================

# Detailliertes Logging aktivieren (true/false)
UART_LOGGING=true
SERVER_LOGGING=true

# ============================================================================
# BEISPIEL SZENARIEN
# ============================================================================

# 1. PRODUKTION (Raspberry Pi mit ESP32)
#    UART_ENABLED=true
#    UART_PORT=/dev/ttyAMA0
#    UART_BAUD=115200
#    NODE_ENV=production

# 2. ENTWICKLUNG (Mit Simulation / Demo-Daten)
#    UART_ENABLED=false
#    NODE_ENV=development

# 3. DEBUGGING (Serial Monitor verbunden)
#    UART_ENABLED=true
#    UART_PORT=/dev/ttyAMA0
#    UART_LOGGING=true
#    SERVER_LOGGING=true
